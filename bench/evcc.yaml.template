# evcc test bench configuration, generated by `bench/start.sh --init`.
# It talks ONLY to the bench board. Never point it at a production wallbox.
network:
  schema: http
  host: localhost
  port: {{EVCC_PORT}}

log: debug
levels:
  cache: error

interval: 10s
telemetry: false

meters:
  # Grid power from the simulator (--grid-file):
  # house load + simulated charging power - simulated PV.
  - name: grid
    type: custom
    power:
      source: script
      cmd: cat {{BENCH_DIR}}/grid_power
      timeout: 2s

chargers:
  - name: testboard
    type: template
    template: heidelberg
    modbus: tcpip
    id: 1
    host: {{ESP_IP}}
    port: 502

vehicles:
  - name: testcar
    type: template
    template: offline
    title: Test car
    capacity: 50

loadpoints:
  - title: Testbench
    charger: testboard
    vehicle: testcar
    mode: pv
    phases: 0
    enable:
      threshold: 0
      delay: 1m
    disable:
      threshold: 0
      delay: 1m

site:
  title: Testbench
  meters:
    grid: grid
